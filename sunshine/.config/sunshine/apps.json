{
    "apps": [
        {
            "image-path": "desktop.png",
            "name": "Desktop"
        },
        {
            "auto-detach": false,
            "detached": [
                "/home/chris/.config/sunshine/prep/bigpicture.sh open"
            ],
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "steam.png",
            "name": "Steam Big Picture",
            "prep-cmd": [
                {
                    "do": "",
                    "undo": "/home/chris/.config/sunshine/prep/bigpicture.sh close"
                },
                {
                    "do": "/home/chris/.config/sunshine/prep/display.sh stream",
                    "undo": "/home/chris/.config/sunshine/prep/display.sh desk"
                }
            ],
            "wait-all": false
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}